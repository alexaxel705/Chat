0419 \u0412\u042c\u0415\u0411\u0410\u0422\u042c\u0421\u042f":6,"\u041d\u0423 \u0421\u041e\u0411\u0421\u0422\u0412\u0415\u041d\u041d\u041e \u0421\u0410\u041c \u0412\u0418\u0414\u0418\u0428\u042c, \u041a\u0410\u041f\u041e\u0422 \u0418 \u0414\u0412\u0415\u0420\u0418 \u041e\u0421\u041e\u0411\u041e \u041d\u0415 \u0413\u041d\u0423\u0422\u0421\u042f":3,"\u041f\u041b\u042e\u0421 \u0415\u0421\u041b\u0418 \u0425\u0415\u0421\u041e\u042f\u041c \u0418\u0425 \u0425\u0418\u041b\u0418\u0422 \u0422\u041e \u0412\u0421\u0401, \u0423 \u041d\u0418\u0425 \u0422\u0415\u0420\u042f\u0415\u0422\u0421\u042f \u0414\u0415\u0424\u041e\u0420\u041c\u0410\u0426\u0418\u042f":1,"\u0413\u041e\u0414\u041d\u041e\u0422\u0410":2,"\u041d\u0423 \u041a\u0410":1,"\u041a\u0421\u0422\u0410\u0422\u0418, \u041c\u041e\u0416\u041d\u041e \u0415\u0429\u0401 \u0412\u041f\u0420\u0410\u0412\u0418\u0422\u042c \u0422\u0410\u0427\u041a\u0423, \u0415\u0421\u041b\u0418 \u0412\u042c\u0415\u0411\u0410\u0422\u042c\u0421\u042f \u0421\u041b\u0415\u0413\u041a\u0410 \u0412 \u0422\u041e \u0416\u0415 \u041c\u0415\u0421\u0422\u041e":1,"\u0425\u0414":2,"\u0422\u042b \u041a\u0410\u0416\u0418\u0421\u042c \u042d\u0422\u041e":1,"\u041f\u041e\u041c\u0418\u0420\u0410\u0415\u0428\u042c":1,"\u0411\u041b\u0418\u041d \u041d\u0415\u041e\u0411\u042b\u0427\u041d\u041e":1,"\u0421\u0410\u041c \u041e\u0425\u0423\u0415\u041b \u041a\u041e\u0413\u0414\u0410 \u0412\u041f\u0415\u0420\u0412\u042b\u0415 \u0423\u0412\u0418\u0414\u0415\u041b \u0422\u0410\u041a\u041e\u0415 \u0423 \u0410\u0424\u0422\u0415\u0420\u0410\u041b\u041b14":1,"\u0422\u0410\u041c \u041d\u0410\u0414\u041e \u0418\u041c\u0415\u041d\u041d\u041e \u0421\u041e \u0412\u0421\u0415\u0419 \u0414\u0423\u0420\u0418 \u0412\u042c\u0415\u0411\u0410\u0422\u042c\u0421\u042f":1,"\u0411\u0415\u041d\u0417\u0418\u041d":1,"\u0410 \u0414\u0415\u0424\u041e\u0420\u041c\u0410\u0426\u0418\u042f \u041a\u0421\u0422\u0410\u0422\u0418 \u041e\u0422\u0420\u0410\u0416\u0410\u0415\u0422\u0421\u042f \u041f\u041e\u0425\u041e\u0416\u0415 \u0422\u041e\u041b\u042c\u041a\u041e \u041d\u0410 \u0422\u0412\u041e\u0419 \u041c\u0410\u0428\u0418\u041d\u0415":1,"\u0423 \u041c\u0415\u041d\u042f \u041e\u0422\u0420\u0410\u0416\u0410\u042e\u0422\u0421\u042f \u0422\u0412\u041e\u0418":1,"\u041a\u0421\u0422\u0410\u0422\u0418 \u041e\u0425\u0423\u0415\u041d\u041d\u041e \u041f\u0420\u0418\u041b\u0415\u0422\u0415\u041b \u0412 \u0416\u041e\u041f\u0423":1,"\u041f\u0420\u042f\u041c \u0412\u041c\u042f\u041b\u041e\u0421\u042c":1,"\u041d\u0423 \u0428\u041e \u0422\u0410\u041c\u0410":1,"\u0413\u041b\u042f\u0416\u0423 \u041d\u0410 \u0414\u0420\u0423\u0413\u0418\u0415 \u0422\u0410\u0427\u041a\u0418":1,"\u0422\u0410\u041c \u041e\u041d\u041e \u0415\u0429\u0401 \u0417\u0410\u0412\u0418\u0421\u0418\u0422 \u041e\u0422 \u041a\u041e\u0415\u0424\u0424\u0418\u0426\u0418\u0415\u041d\u0422\u0410 \u041f\u041e\u0412\u0420\u0415\u0416\u0414\u0415\u041d\u0418\u042f":1,"\u0412\u0420\u041e\u0414\u0415":1,"\u041f\u0420\u042f\u041c FLATOUT":1,"\u0418 \u0415\u0429\u0401 \u041e\u0422 \u041c\u0410\u0421\u0421\u042b \u0422\u0410\u0427\u041a\u0418":1,"\u0421\u041a\u041e\u0420\u0415\u0415 \u0416\u0422\u0410 4":1,"\u0422\u041e\u041a \u0421\u042b\u0420\u0410\u042f":1,"\u0414\u041e \u0424\u041b\u0415\u0422\u0410\u0423\u0422 \u0415\u0429\u0401 \u0420\u0410\u0421\u0422\u0418 \u0418 \u0420\u0410\u0421\u0422\u0418":1,"\u041e\u041d \u0415\u0413\u041e \u0411\u0423\u0414\u0415\u0422 \u0414\u041e\u041f\u0418\u041b\u0418\u0412\u0410\u0422\u042c?":1,"\u041e\u041d \u0421\u041a\u0410\u0417\u0410\u041b \u0427\u0422\u041e \u0417\u0410\u041d\u042f\u0422 \u0427\u0415\u041c \u0422\u041e \u0421\u0412\u041e\u0418\u041c":1,"\u0422\u0410\u041c \u0423 \u041d\u0415\u0413\u041e \u041a\u0410\u041a\u0410\u042f \u0422\u041e \u0421\u0422\u0410\u0420\u0410\u042f \u0418\u0413\u0420\u0410 \u041f\u0420\u041e \u0421\u0420\u0415\u0414\u041d\u0415\u0412\u0415\u041a\u041e\u0412\u042c\u0415":1,"\u041d\u0410 \u041f\u041e\u041b\u042c\u0421\u041a\u041e\u041c \u0422\u041e\u0416\u0415":1,"\u042f \u041a\u041e\u0413\u0414\u0410 \u0414\u0410\u041b \u0415\u041c\u0423 \u0428\u0415\u0419\u0414\u0415\u0420\u042b \u0410\u0424\u0422\u0415\u0420\u0410\u041b\u041b14":1,"\u041e\u041d \u041a\u0410\u041f\u0415\u0426 \u041a\u0410\u041a \u041e\u0411\u0420\u0410\u0414\u041e\u0412\u0410\u041b\u0421\u042f":1,"\u0421\u041a\u0410\u0417\u0410\u041b \u0427\u0422\u041e \u041a\u0410\u041a \u041d\u0418\u0411\u0423\u0414\u042c \u041a\u041e\u0413\u0414\u0410 \u041d\u0418\u0411\u0423\u0414\u042c \u0421\u0414\u0415\u041b\u0410\u0415\u0422 \u0418 \u041d\u0410 \u041d\u0418\u0425 \u0422\u041e\u0416\u0415 \u0421\u0410\u041c\u041e\u0415":1,"\u0411\u041b\u042f\u0411":1,"\u041d\u0415 \u0414\u041e\u0422\u042f\u041d\u0423\u041b":1,"\u041d\u0423 \u041a\u0410\u0420\u041e\u0427 \u0422\u0418 \u041f\u041e\u041d\u042f\u041b":2,"\u0427\u0415\u0422\u041a\u041e":1,"\u0412\u041e\u0422 \u0427\u0422\u041e \u042f \u0425\u041e\u0422\u0415\u041b \u0412\u0421\u0401 \u042d\u0422\u041e \u0412\u0420\u0415\u041c\u042f":1,"\u0418 \u041f\u041e\u041b\u0423\u0427\u0418\u041b \u0422\u041e\u041b\u042c\u041a\u041e \u0421\u041f\u0423\u0421\u0422\u042f 2-3 \u0413\u041e\u0414\u0410 \u0425\u0414":1,"\u041a\u0410\u041a \u0423 \u0412\u0410\u0421 \u041e\u0411\u0421\u0422\u0410\u041d\u041e\u0412\u041a\u0410 \u0412 \u041c\u041e\u0421\u041a\u0412\u0415?":1,"\u0422\u0410 \u0417\u0410\u0415\u0411\u0418\u0421":2,"\u042f \u0427\u0423\u0422\u042c \u0414\u0410\u041b\u042c\u0428\u0415 \u041e\u0422 \u041c\u041e\u0421\u041a\u0412\u042b":1,"\u0421\u041a\u0410 \u0412 \u041d\u041e\u0412\u041e\u0421\u0418\u0411 \u041d\u0415\u0414\u0410\u0412\u041d\u041e \u0415\u0417\u0414\u0418\u041b":1,"\u041c\u041d\u0415 \u041d\u041e\u0420\u041c\u0410\u0421 \u041a\u0410\u041a \u0411\u042b":1,"\u041f\u041e\u041b \u0413\u041e\u0420\u041e\u0414\u0410 \u0417\u0410\u041a\u0420\u042b\u0422\u041e":1,"\u041d\u0415, \u0423 \u041d\u0410\u0421 \u0417\u0410\u0415\u0411\u0418\u0421\u042c \u0412\u0421\u0401":1,"\u0412\u0421\u0401 \u041e\u0422\u041a\u0420\u042b\u0422\u041e":1,"28 \u0427\u0418\u0421\u041b\u0410 \u041f\u041e\u0428\u041b\u0418 \u0421 \u0420\u0415\u0411\u042f\u0422\u0410\u041c\u0418 \u0412 \u041b\u0415\u0421 \u0411\u0423\u0425\u0410\u0422\u042c":1,"\u0414\u041d\u042e\u0425\u0410 \u0423 \u0427\u0423\u0412\u0410\u041a\u0410 \u0411\u042b\u041b\u0410":1,"\u041f\u041e\u0427\u0422\u0418 \u0412\u0421\u042f \u041f\u0410\u041d\u041a \u0422\u0423\u0421\u041e\u0412\u041a\u0410 \u0421\u041e\u0411\u0420\u0410\u041b\u0410\u0421\u042c":1,"\u0423 \u041c\u041e\u0415\u0413\u041e \u041a\u041e\u041b\u041b\u0415\u0413\u0418 \u0416\u0415\u041d\u042b \u041d\u0410\u0428\u041b\u0418 COVID":1,"\u0415\u0413\u041e \u0412 \u041a\u0410\u0420\u0410\u041d\u0422\u0418\u041d \u041f\u041e\u0421\u0410\u0414\u0418\u041b\u0418":1,"\u0421\u0415\u0419\u0427\u0410\u0421 \u0413\u0420\u0410\u0424\u0418\u041a \u041f\u041b\u041e\u0422\u041d\u042b\u0419":1,"\u0418 \u0427\u0415, \u0412\u0421\u0401?":2,"\u0415\u0421\u041b\u0418 \u0423 \u041d\u0415\u0413\u041e \u041f\u041e\u0414\u0422\u0412\u0415\u0420\u0414\u042f\u0422":1,"\u041d\u0410\u0421 \u041d\u0410 \u041f\u0420\u041e\u0412\u0415\u0420\u041a\u0423))":1,"\u041a\u0421\u0422\u0410\u0422\u0418, \u0417\u0410\u041c\u0415\u0422\u0418\u041b \u041a\u0410\u041a \u0416\u041e\u041f\u0423 \u0412\u042b\u041f\u0420\u0410\u0412\u0418\u041b?":1,"\u041d\u0415 \u041e\u0411\u0420\u0410\u0422\u0418\u041b":1,"\u041a\u0410\u0420\u041e\u0427 \u0429\u0410 \u0415\u0429\u0401 \u0420\u0410\u0417 \u041f\u041e\u041f\u0420\u041e\u0411\u0423\u042e":1,"\u0421\u041a\u0420\u0418\u041f\u0422 \u0417\u0410\u0427\u0415\u0422\u041d\u042b\u0419":1,"\u0421\u041a\u0420\u0418\u041f\u0422 \u0414\u0410, \u0417\u0410\u0415\u0411\u0418\u0421\u042c":1,"\u041d\u041e \u041f\u0420\u0415\u0414\u042b\u0414\u0423\u0429\u0410\u042f \u0412\u0415\u0420\u0421\u0418\u042f, \u041a\u041e\u0422\u041e\u0420\u0410\u042f \u0421\u041e \u0421\u041f\u0418\u0417\u0416\u0415\u041d\u041d\u042b\u041c \u0428\u0415\u0419\u0414\u0415\u0420\u041e\u041c":1,"\u0411\u042b\u041b\u0410 \u041a\u0423\u0414\u0410 \u041b\u0423\u0427\u0428\u0415":1,"\u0422\u042b \u0415\u0413\u041e \u041e\u041f\u0423\u0411\u041b\u0418\u041a\u041e\u0412\u0410\u0422\u042c \u0425\u041e\u0427\u0415\u0428\u042c?":1,"\u041d\u0415, \u041d\u0418 \u0412 \u041a\u041e\u0415\u041c \u0421\u041b\u0423\u0427\u0410\u0415":1,"\u042d\u0422\u041e \u041f\u0420\u0418\u0412\u0410\u0422 \u0422\u041e\u0413\u041e \u0427\u0423\u0412\u0410\u041a\u0410":1,"\u041c\u042b \u041e\u0411\u041c\u0415\u041d\u042f\u041b\u0418\u0421\u042c \u0422\u0410\u041a \u0421\u041a\u0410\u0417\u0410\u0422\u042c :P":1,"\u041a\u0410\u041a \u0411\u042b \u0415\u0421\u041b\u0418 \u0414\u041e\u041f\u0418\u0428\u0415\u0428\u042c - \u0412\u0410\u0429\u0415 \u0417\u0410\u0415\u0411\u0418\u0421":1,"\u041f\u041e\u041a\u041e\u0412\u042b\u0420\u042f\u042e, \u041d\u041e \u042f \u0412 \u0428\u0415\u0419\u0414\u0415\u0420\u0410\u0425 \u041d\u041e\u041b\u042c":1,"\u041d\u0415, \u041d\u0423 \u041a\u0410\u041a \u0411\u042b \u0420\u0410\u0411\u041e\u0427\u0418\u0419 \u042d\u041a\u0417\u0415\u041c\u041f\u041b\u042f\u0420 \u0415\u0421\u0422\u042c":1,"\u041e\u0421\u0422\u0410\u041b\u041e\u0421\u042c \u0422\u041e\u041a \u0414\u041e\u041f\u0418\u041b\u0418\u0422\u042c \u0414\u041e \u0418\u0414\u0415\u0410\u041b\u0410":1,"\u041a\u041e\u041c\u041c\u0423\u041d\u0418\u0421\u0422 \u041d\u0410\u0428 \u041f\u0420\u041e\u041f\u0410\u041b \u041a\u0423\u0414\u0410 \u0422\u041e":2,"\u041a\u041e\u041c\u041c\u0423\u041d\u0418\u0421\u0422...":1,"\u0422\u041e\u0422 \u0427\u0422\u041e \u0422\u0410\u041a\u0421\u0423 \u0414\u0410\u0412\u0410\u041b?":1,"\u041e\u041d \u0418\u0417 \u041d\u0421\u041a \u041a\u0410\u041a \u0420\u0410\u0417":1,"F.":1,"\u041d\u0410\u0414\u041e \u0411\u0423\u0414\u0415\u0422 \u0421\u041b\u041e\u0412\u0418\u0422\u0421\u042f \u0421 \u041d\u0418\u041c":1,"\u0421\u041e\u0411\u0418\u0420\u0410\u042e\u0421\u042c \u0417\u0410 \u041f\u041e\u041a\u0423\u041f\u041a\u0410\u041c\u0418 \u042d\u0422\u0418\u041c \u041b\u0415\u0422\u041e\u041c \u0415\u0429\u0415 \u0420\u0410\u0417":2,"\u0420\u0423\u041b \u041d\u041d\u0410\u0414\u0410? XD":1,"\u041c\u041e\u0416\u0415\u0422 \u0424\u041e\u0422\u041a\u0418 \u0417\u0410\u0415\u0411\u0410\u0428\u0418\u041c":1,"\u041a\u0423\u0414\u042b \u0412\u0410\u041b\u0418\u041c?":1,"\u0412 BONE COUNTY":1,"\u041d\u0410\u0414\u0415\u042e\u0421\u042c \u0415\u0429\u0401 \u0411\u041e\u041b\u0415\u0417\u041d\u0415\u0419 \u0417\u0410 \u0427\u0418\u0422\u042b \u041d\u0415\u0422":1,"\u0410 \u0421\u0410\u041c\u041e\u041b\u0415\u0422\u042b \u0414\u0415\u0424\u041e\u0420\u041c\u0418\u0420\u0423\u042e\u0422\u0421\u042f?":1,"\u042f \u041d\u0410 \u0421\u0412\u041e\u0401\u041c \u0421\u0415\u0420\u0412\u0415\u0420\u0415 \u0423\u041c\u0423\u0414\u0420\u0418\u041b\u0421\u042f \u0414\u0415\u0424\u041e\u0420\u041c\u0418\u0420\u041e\u0412\u0410\u0422\u042c \u0412\u0415\u0420\u0422\u041e\u041b\u0401\u0422":1,"\u041a\u0410\u041a \u0411\u042b \u0427\u0422\u041e\u0411 \u041d\u0415 \u0420\u0412\u0410\u041d\u0423\u041b\u0410 \u0410\u041d\u0414\u0420\u041e\u041c\u0415\u0414\u0410":1,"\u0410 \u0422\u041e \u041f\u041e\u041c\u041d\u042e \u041a\u0410\u041a\u041e\u0419 \u0423 \u041d\u0415\u0401 \u0412\u0417\u0420\u042b\u0412":1,"\u0421\u0420\u0410\u0417\u0423 6 \u0428\u0422\u0423\u041a":1,"\u0410\u041d\u0414\u0420\u041e\u041c\u0415\u0414\u0410 \u0422\u0415\u0420\u0420\u041e\u0420\u0418\u0421\u0422\u041e\u0412":1,"\u0421 \u041f\u0420\u041e\u0421\u0422\u041e \u0422\u0410\u041a \u041a\u041d\u0428 \u0425\u0423\u0419 \u041f\u041e\u041c\u041d\u0401\u0428\u042c":1,"\u042f \u041a\u0421\u0422\u0410 \u0411\u041e\u0427\u0418\u041d\u0423 \u0412\u041c\u042f\u041b":1,"\u0423\u0425 \u0401\u041f\u0422\u0410":1,"\u0422\u0415\u041f\u0415\u0420\u042c \u041c\u041e\u0416\u041d\u041e":1,"\u0410 \u041d\u0415\u0422":1,"\u0420\u0415\u0421\u041f\u0410\u0412\u041d\u0423\u041b\u0410\u0421\u042c":1,"\u0414\u041e\u041b\u0413\u041e?":1,"\u041a\u041e\u0424\u0415 \u041f\u041e\u041f\u042c\u042e, \u0414\u0410 \u041f\u041e \u0414\u041e\u041c\u0423 \u0423\u0411\u0420\u0410\u0422\u042c\u0421\u042f \u041d\u0410\u0414\u041e":1,"\u0410, \u041e\u041a\u0415":1,"\u041a\u0410\u041a \u0422\u0423\u0422 \u0418\u0413\u0420\u0410\u0422\u042c?":1,"\u0427\u0422\u041e?":1,"\u0414\u0415\u0420\u0416\u0418":1,"\u0419\u0423\u0425":1,"\u041a\u0423\u0419":4,"\u0421\u041f\u0420\u0410\u0412\u0415\u0411\u042b\u0414\u041b\u041e":5,"\u0427\u0410\u0422 \u041e\u041f\u042f\u0422\u042c \u0421\u041b\u041e\u041c\u0410\u041b\u0421\u042f :C":5,"\u041a\u0420\u0410\u0424\u0422\u041e\u0412\u041e\u0415 \u041f\u0418\u0412\u041e \u041f\u0420\u041e\u0411\u041e\u0412\u0410\u041b?":6,"\u0414\u0410\u0416\u0415 \u0425\u0417 \u0428\u041e \u0426\u0415 \u0422\u0410\u041a\u041e\u0415":3,"\u0422\u0418\u041f\u0410 \u0418\u0417 \u041d\u0410\u0417\u0412\u0410\u041d\u0418\u042f \u041b\u041e\u0413\u0418\u0427\u041d\u041e \u0427\u0422\u041e \u0415\u0413\u041e \u0412\u0420\u0423\u0427\u041d\u0423\u042e \u0414\u0415\u041b\u0410\u042e\u0422 \u041a\u0410\u041a \u0422\u041e":1,"\u0422\u0410\u041c \u0422\u0418\u041f\u041e \u0425\u041c\u0415\u041b\u042f \u0414\u041e\u0425\u0415\u0420\u0410":1,"\u041f\u041e \u0412\u041a\u0423\u0421\u0423 \u042f\u0414\u0415\u0420\u041d\u0410\u042f \u0411\u041e\u041c\u0411\u0410":1,"\u0413\u041e\u0420\u042c\u041a\u0410\u042f":1,"\u0426\u0415 \u041a\u0410\u041a...":1,"\u0410, \u041f\u041e\u041d\u042f\u041b":1,"\u0410 \u0412\u042b \u0427\u0422\u041e \u0411\u0423\u0425\u0410\u041b\u0418 \u0412 \u041b\u0415\u0421\u0423?":1,"387":1,"\u0411\u0423\u0414":1,"\u0427\u0422\u041e \u0422\u0410\u041c \u0415\u0429\u0401 \u0411\u042b\u041b\u041e...":1,"\u0414\u041e\u0425\u0415\u0420\u0410 \u0412\u0418\u0421\u041a\u0410\u0420\u042f \u0420\u0410\u0417\u041d\u042b\u0425 \u0421\u041e\u0420\u0422\u041e\u0412":1,"\u041a\u041e\u041b\u0410 \u0427\u0422\u041e\u0411 \u0428\u041e\u0422\u042b \u0414\u0415\u041b\u0410\u0422\u042c":3,"\u041a\u0421\u0422\u0410\u0422\u0418 \u0412\u0418\u0421\u041a\u0410\u0420\u042c":1,"\u0418\u041b\u0418 \u041d\u0415 \u041a\u041e\u041b\u0410... \u0427\u0415\u0422 \u0422\u0410\u041c \u0411\u042b\u041b\u041e \u041a\u0410\u0420\u041e\u0427":1,"\u0421\u0418\u041d\u0410\u0422\u0420\u0410 \u0415\u0413\u041e \u0413\u041b\u0423\u0428\u0418\u041b \u041f\u041e \u0411\u0423\u0422\u042b\u041b\u041a\u0415 \u0412 \u0414\u0415\u041d\u042c":1,"\u041d\u041e \u041e\u041d \u0415\u0413\u041e \u041b\u042c\u0414\u041e\u041c \u0420\u0410\u0417\u0411\u0410\u0412\u041b\u042f\u041b":1,"\u0414\u041e 12% \u041f\u0420\u0418\u041c\u0415\u0420\u041d\u041e":2,"\u0423 \u041d\u0410\u0421 \u0411\u042b\u041b\u0410 \u0425\u041e\u041b\u041e\u0414\u041d\u0410\u042f \u041a\u041e\u041b\u0410":1,"\u0414\u0416\u0415\u041a \u0414\u0415\u041d\u0418\u0415\u041b\u0421 \u0422\u041e\u041f":1,"\u0410, \u0415\u0429\u0401 \u042d\u041d\u0415\u0420\u0413\u0415\u0422\u041e\u0421 \u0421 \u0412\u041e\u0414\u042f\u0420\u041e\u0419":1,"\u041b\u042f \u041c\u041e\u0422\u041e\u0420 \u041e\u0422 \u0422\u0410\u041a\u041e\u0413\u041e \u041e\u0422\u041a\u0410\u0416\u0415\u0422":1,"\u0418\u041b\u0418 \u041d\u0415 \u0411\u042b\u041b\u041e \u0412\u041e\u0414\u042f\u0420\u042b... \u041a\u0410\u0420\u041e\u0427 \u0411\u042b\u041b\u041e \u0412\u0415\u0421\u0415\u041b\u041e":1,"\u041a\u0410\u041a \u0420\u0410\u0417 \u0422\u0410\u041a\u0418 \u041e\u0425\u0423\u0415\u041d\u041d\u0410\u042f \u0422\u0415\u041c\u0410 \u0427\u0422\u041e\u0411 \u0412\u0417\u0411\u041e\u0414\u0420\u0418\u0422\u042c\u0421\u042f":1,"\u042f \u041e\u0411\u042b\u0427\u041d\u041e \u0411\u0423\u0425\u041b\u041e \u0427\u0423\u0422\u041e\u041a \u042d\u041d\u0415\u0420\u0413\u0415\u0422\u0418\u041a\u041e\u041c \u0417\u0410\u041f\u0418\u0412\u0410\u042e, \u0427\u0422\u041e\u0411\u042b \u0411\u042b\u0422\u042c \u0411\u041e\u041b\u0415\u0415 \u041c\u0415\u041d\u0415\u0415 \u0416\u0418\u0412\u042b\u041c":1,"\u0421\u041a\u0410 \u041a\u0420\u0410\u0428\u0418":1,"\u0422\u0410\u041c \u0417\u041e\u041d\u0410 \u0410\u041d\u041e\u041c\u0410\u041b\u042c\u041d\u0410\u042f":1,"\u0423 \u041c\u0415\u041d\u042f \u0420\u0410\u041d\u042c\u0428\u0415 \u041a\u0420\u0410\u0428\u0418 \u0422\u0410\u041c \u0421\u041b\u0423\u0427\u0410\u041b\u0418\u0421\u042c":1,"\u0426\u041f 100%":1,"\u042f \u041f\u041e\u0422\u041e\u041c\u0423 \u0418 \u0417\u0410\u0411\u0418\u041b":1,"\u041d\u0423 \u041a\u0410\u0420\u041e\u0427":1,"\u042f \u041e\u0411\u042b\u0427\u041d\u041e \u0417\u0410\u041b\u0418\u0412\u0410\u042e\u0421\u042c \u0427\u0423\u0422\u041e\u041a \u042d\u041d\u0415\u0420\u0413\u0415\u0422\u0418\u041a\u041e\u041c":1,"\u041f\u041e\u0421\u041b\u0415 \u0411\u0423\u0425\u041b\u0410":1,"\u0422\u0410\u041a \u0422\u0418\u041f \u0411\u042b\u0421\u0422\u0420\u041e \u041c\u041e\u0416\u041d\u041e \u041f\u0420\u041e\u0422\u0420\u0415\u0417\u0412\u0415\u0422\u042c":1,"\u0421\u0415\u0419\u0427\u0410\u0421 \u041c\u041e\u0421\u041a\u041e\u0412\u0421\u041a\u0418\u0415 \u042d\u041d\u0415\u0420\u0413\u0415\u0422\u0418\u041a\u0418 \u041d\u0410\u041c \u0417\u0410\u0412\u0415\u0417\u041b\u0418":1,"GALAXY \u0412\u0420\u041e\u0414\u0415":1,"\u0424\u0418\u041e\u041b\u0415\u0422\u041e\u0412\u042b\u0415":1,"\u0425\u0417 \u0427\u0415\u0421\u041d":1,"\u0414\u041e \u041d\u0410\u0421 \u0415\u0429\u0401 \u041d\u0415 \u0414\u041e\u0428\u041b\u0418":1,"\u0411\u041b\u042f\u0422\u042c":1,"\u0411\u0415\u041d\u0417\u041e\u041a\u041e\u041b\u041e\u041d\u041a\u0410 \u041e\u0422\u041a\u0410\u0417\u0410\u041b\u0410":1,"\u041f\u0418\u0417\u0414\u0410\u0420\u0418\u041a\u0418 \u0425\u0414":1,"\u0417\u0410\u0422\u041e \u0427\u0410\u0422 \u0412\u0415\u0420\u041d\u0423\u041b\u0421\u042f":1,"\u0421\u0415\u0420\u0412\u0415\u0420 \u0412 \u0421\u0412\u041e\u0415\u041c \u0420\u0415\u041f\u0415\u0420\u0422\u0423\u0410\u0420\u0415":1,"\u0416\u0418\u0412\u0415\u0422 \u0421\u0412\u041e\u0415\u0419 \u0416\u0418\u0417\u041d\u042c\u042e":1,"\u0422\u041e\u0416\u0415 \u041d\u0410 \u041a\u0410\u041d\u0418\u041a\u0423\u041b\u0410\u0425":1,"\u0422\u0423\u0422 \u0412\u0421\u042f\u041a\u0418\u0415 \u0418\u041b\u041e\u041d\u042b \u041c\u0410\u0421\u041a\u0418 \u0417\u0410\u0425\u041e\u0414\u0418\u041b\u0418":1,"\u041d\u0423 \u0418?":1,"\u041f\u0415\u0420\u0415\u041f\u0423\u0413\u0410\u041b\u0421\u042f, \u0414\u0423\u041c\u0410\u041b \u0421\u0418\u041e\u041d\u0418\u0421\u0422\u042b \u041e\u041a\u0420\u0423\u0416\u0418\u041b\u0418":1,"\u0422\u042b \u0422\u0410\u041c \u0421\u041c\u041e\u0422\u0420\u0418 \u0427\u0422\u041e\u0411 \u041a\u041e\u0412\u0410\u041b\u0415\u0412\u0421\u041a\u0418\u0415 \u0412\u0421\u042f\u041a\u0418\u0415 \u041d\u0415 \u041f\u0420\u0418\u0428\u041b\u0418 \u0422\u0423\u0422":1,"\u0417\u0410 \u0422\u041e \u0427\u0422\u041e \u0417\u0418\u0413\u0423 \u041d\u0410 \u0414\u041d\u042f\u0425 \u041a\u0418\u0414\u0410\u041b":1,"\u0412 \u041f\u041e\u0421\u041b\u0415\u0414\u041d\u0418\u0419 \u0420\u0410\u0417 \u041a\u041e\u0413\u0414\u0410 \u041a\u041e\u0412\u0410\u041b\u0415\u0412\u0421\u041a\u0418\u0419 \u0417\u0410\u0425\u0412\u0410\u0422\u0418\u041b \u0421\u0415\u0420\u0412\u0415\u0420 - \u041f\u0420\u041e\u0418\u0417\u041e\u0428\u0401\u041b \u041f\u0418\u0417\u0414\u0415\u0426":1,"\u0421\u0422\u0420\u0418\u041c\u0415\u0420?":1,"\u0421\u0422\u0420\u0418\u041c\u0415\u0420, \u042e\u0422\u0423\u0411\u0415\u0420":1,"\u041a\u0410\u0420\u041e\u0427 \u0412\u042b\u0421\u041a\u041e\u0427\u041a\u0410":1,"\u0417\u0410\u0420\u0410\u0411\u0410\u0422\u042b\u0412\u0410\u0415\u0422 \u041d\u0410 \u0412\u0421\u0401\u041c \u041f\u041e\u0414\u0420\u042f\u0414":1,"\u041d\u0423 \u0422\u0410\u041a \u0412\u041e\u0422, \u0411\u042b\u041b NFS PROJECT \u041e\u0422 AFTERALL14":1,"\u041f\u041e\u0421\u041b\u0415 \u041a\u041e\u0412\u0410\u041b\u0415\u0412\u0421\u041a\u041e\u0413\u041e \u0421\u0422\u0410\u041b\u041e... \u0420\u0410\u0414\u041c\u0418\u0420 \u0425\u041e\u0420\u0410\u0419\u0417\u041e\u041d":1,"\u041a\u041e\u0422\u041e\u0420\u041e\u0415 \u041a \u0421\u041b\u041e\u0412\u0423 \u0421\u0415\u0419\u0427\u0410\u0421 \u0417\u0410\u041a\u0420\u042b\u0422\u041e":1,"\u0418 \u0412\u0420\u041e\u0414\u0415 \u041a\u0410\u041a \u041d\u0415 \u041e\u0422\u041a\u0420\u042b\u0412\u0410\u041b\u041e\u0421\u042c \u0412\u041e\u041e\u0411\u0429\u0415":1,"\u041d\u0415 \u0428\u0410\u0420\u042e, \u042f \u0414\u0410\u041b\u042c\u0428\u0415 \u0421\u0412\u041e\u0415\u0413\u041e \u0421\u0415\u0420\u0412\u0415\u0420\u0410 \u041d\u0418\u0427\u0415\u0413\u041e \u041d\u0415 \u0412\u0418\u0414\u0415\u041b":1,"\u0422\u041e\u041b\u042c\u041a\u041e \u0417\u0410\u0419\u0414\u0415\u0428\u042c \u041a\u0423\u0414\u0410 \u041d\u0418\u0411\u0423\u0414\u042c, \u0417\u0410 \u041f\u0420\u0418\u0421\u0422\u0423\u041f\u042b \u0410\u041d\u0410\u0420\u0425\u0418\u0418 \u0411\u0410\u041d \u041f\u041e\u041b\u0423\u0427\u0410\u042e":1,"\u041d\u0423 \u0412\u041e\u0422 \u041f\u041e\u0422\u041e\u041c\u0423 \u041c\u041d\u0415 \u0418 \u041f\u0420\u0418\u0425\u041e\u0414\u0418\u0422\u0421\u042f \u0422\u0415\u0411\u0415 \u041d\u0415\u0421\u0422\u0418 \u041a\u041e\u0414 \u0428\u041a\u041e\u041b\u042c\u041d\u0418\u041a\u041e\u0412 \u041d\u0410 \u041f\u0420\u041e\u0412\u0415\u0420\u041a\u0423":1,"\u0425\u041e\u0422\u042f \u041a\u0421\u0422\u0410\u0422\u0418... \u042f \u041f\u041e\u041c\u041d\u042e \u041a\u0410\u041a \u0422\u042b \u0420\u0410\u041d\u042c\u0428\u0415 \u0413\u041e\u0412\u041e\u0420\u0418\u041b \u041d\u0418 \u0415\u0414\u0418\u041d\u041e\u0413\u041e \u0421\u041a\u0420\u0418\u041f\u0422\u0410 \u0418\u0417 \u0412\u041d\u0415":1,"\u041e\u041d\u0418 \u0429\u0410\u0421 \u041c\u041e\u0414\u0423\u041b\u042c\u041d\u042b\u0415":1,"\u042f \u0412\u0415\u0414\u042c \u041f\u0415\u0420\u0415\u0414\u0410\u041b\u0410\u041b \u0421\u0415\u0420\u0412\u0415\u0420, \u0418\u0417 \u041c\u041e\u041d\u041e\u041b\u0418\u0422\u041d\u041e\u0413\u041e":1,"\u041a\u0421\u0422\u0410\u0422\u0418 \u0413\u041e\u0412\u041e\u0420\u042f... \u042f \u0427\u0423\u0422\u041e\u041a \u0417\u0410\u0411\u042b\u041b \u041a\u0410\u041a \u0412\u042b\u0413\u041b\u042f\u0414\u0415\u041b \u0421\u0422\u0410\u0420\u042b\u0419 \u041f\u0418\u0417\u0414\u041e\u041c\u0415\u0422\u0420":1,"\u0422\u041e\u0427\u041d\u0415\u0415 \u041d\u041e\u0412\u042b\u0419":1,"\u041d\u041e \u041a\u041e\u0422\u041e\u0420\u042b\u0419 \u0423\u0416\u0415 \u0421\u0422\u0410\u0420\u042b\u0419":1,"\u042f \u041d\u0415 \u0420\u0415\u0428\u0418\u041b \u0415\u0429\u0415 \u041a\u0421\u0422\u0410\u0422\u0418":1,"\u0412 \u041a\u0410\u041a\u041e\u041c \u0416\u0410\u041d\u0420\u0415 \u0425\u041e\u0427\u0423 \u0420\u0410\u0417\u0412\u0418\u0412\u0410\u0422\u042c \u0421\u0415\u0420\u0412\u0415\u0420":1,"\u041d\u0423, \u0422\u0423\u0422 \u041f\u041e\u0422\u0415\u041d\u0426\u0418\u0410\u041b \u041e\u0413\u0420\u041e\u041c\u041d\u042b\u0419":1,"\u0412 \u041a\u0410\u0416\u0414\u041e\u041c \u041d\u0410\u041f\u0420\u0410\u0412\u041b\u0415\u041d\u0418\u0418":1,"\u0415\u0411\u0410\u0422\u042c \u0422\u042f\u041d \u0411\u0415\u0428\u0415\u041d\u041d\u0410\u042f":1,"\u0416\u0414\u0423 1.6 \u0412\u0415\u0420\u0421\u0418\u042e":1,"\u041f\u041e\u0414 1.6":1,"\u041d\u0410\u0414\u041e \u0411\u0423\u0414\u0415\u0422 \u0418\u041d\u0412\u0415\u041d\u0422\u0410\u0420\u042c \u041f\u0415\u0420\u0415\u0414\u0415\u041b\u042b\u0412\u0410\u0422\u042c":1,"\u0422\u0415\u041a\u0421\u0422\u0423\u0420\u041a\u0418 \u041c\u041e\u0416\u041d\u041e \u0411\u0423\u0414\u0415\u0422 \u0418\u0417\u0412\u041b\u0415\u041a\u0410\u0422\u042c \u0418\u0417 \u0418\u0413\u0420\u042b":1,"\u0425\u0410\u0421\u041a\u0415\u041b\u042c \u041f\u041e\u0414\u0421\u041a\u0410\u0417\u0410\u041b ":1,"\u041e, \u0417\u0410\u0415\u0411\u0418\u0421":1,"\u0425\u0410\u0421\u041a\u0415\u041b\u042c \u041a\u0421\u0422\u0410\u0422\u0418 \u041e\u041a\u0410\u0417\u042b\u0412\u0410\u0415\u0422\u0421\u042f \u041f\u0420\u041e\u0414\u0410\u041b \u0421\u0412\u041e\u042e \u0416\u041e\u041f\u0423 \u041c\u0422\u0410\u0428\u041d\u0418\u041a\u0410\u041c":1,"\u0422\u041e\u0427\u041d\u0415\u0415 \u0420\u0410\u0417\u0420\u0410\u0411\u0410\u041c \u041c\u0422\u0410":1,"\u042d\u0422\u041e \u041a\u0410\u041a":1,"\u041d\u0423 \u0420\u0410\u041d\u042c\u0428\u0415 \u0421\u041c\u0410\u0420\u0418, \u0411\u042b\u041b \u0422\u0410\u041a\u041e\u0419 \u0425\u0410\u0421\u041a\u0415\u041b\u042c \u0427\u0418\u0422\u0415\u0420":1,"\u041b\u041e\u041c\u0410\u041b \u0412\u0421\u042f\u041a\u0418\u0415 \u0421\u0415\u0420\u0412\u0415\u0420\u0410":1,"\u0410 \u041f\u041e\u0422\u041e\u041c \u0427\u0401\u0422 \u0412\u041d\u0415\u0417\u0410\u041f\u041d\u041e \u0412\u0417\u042f\u041b \u0418 \u041f\u0420\u041e\u0414\u0410\u041b \u0421\u0412\u041e\u042e \u0416\u041e\u041f\u0423 \u0417\u0410 \u0420\u0410\u0417\u0411\u0410\u041d \u0418 \u041d\u0415\u041f\u0420\u0418\u041a\u041e\u0421\u041d\u041e\u0412\u0415\u041d\u041d\u041e\u0421\u0422\u042c":1,"\u0421\u041d\u0410\u0427\u0410\u041b\u0410 \u0412\u0421\u0415\u041c \u0413\u041e\u0412\u041e\u0420\u0418\u041b \u0427\u0422\u041e \u042d\u0422\u041e \u0415\u0413\u041e \u0423\u0429\u0415\u041c\u041b\u042f\u042e\u0422, \u0415\u0413\u041e \u0418\u0413\u0420\u041e\u041a\u041e\u0412 \u0421 \u0421\u0415\u0420\u0412\u0415\u0420\u0410 \u0411\u0410\u041d\u042f\u0422":1,"\u0410 \u041f\u041e\u0422\u041e\u041c \u041f\u0420\u0410\u0412\u0414\u0410 \u0420\u0410\u0421\u041a\u0420\u042b\u041b\u0410\u0421\u042c":1,"\u041f\u041e \u041a\u0420\u0410\u0419\u041d\u0415\u0419 \u041c\u0415\u0420\u0415 \u042d\u0422\u041e \u0422\u041e \u0427\u0422\u041e \u042f \u0423\u0417\u041d\u0410\u041b \u041e\u0422 \u0415\u0413\u041e \u0411\u042b\u0412\u0428\u0415\u0413\u041e \u041a\u041e\u041b\u041b\u0415\u0413\u0418 \u0427\u0418\u0422\u0415\u0420\u0410":1,"\u041a\u0420\u0418\u041c\u0418\u041d\u0410\u041b\u042c\u041d\u0410\u042f \u0421\u0422\u0420\u0423\u041a\u0422\u0423\u0420\u0410 \u041a\u0410\u041a\u0410\u042f \u0422\u041e":1,"\u0410 \u0425\u0423\u041b\u0418":1,"\u042f \u041a\u0421\u0422\u0410\u0422\u0418 \u0422\u041e\u0416\u0415 \u0422\u0415\u041f\u0415\u0420\u042c \u041f\u041e\u0414 \u041f\u0420\u0418\u0426\u0415\u041b\u041e\u041c \u0425\u0414":1,"\u041c\u041e\u0413\u0423 \u041b\u0410\u0419\u0424\u0425\u0410\u041a \u041f\u041e\u0414\u0421\u041a\u0410\u0417\u0410\u0422\u042c":1,"\u041a\u041e\u0413\u0414\u0410 \u041f\u041e\u0419\u041c\u0410\u042e\u0422":1,"\u041a\u0420\u0418\u0427\u0418":1,"\u041d\u0415 \u0411\u0415\u0419\u0422\u0415 \u041b\u0423\u0427\u0428\u0415 \u041e\u0411\u041e\u0421\u0421\u042b\u0422\u0415, \u042f \u042d\u0422\u041e\u041c\u0423 \u0423 \u0410\u041d\u0418\u041c\u0415\u0428\u041d\u0418\u041a\u041e\u0412 \u041d\u0410\u0423\u0427\u0418\u041b\u0421\u042f":1,"\u0410, \u0422\u0410 \u0424\u0418\u0413\u041d\u042f":1,"\u0411\u042b\u041b\u0418 \u0411\u042b \u0420\u0423\u0421\u0421\u041a\u0418\u0415 \u0422\u0410\u041a \u0411\u042b \u0418 \u0421\u041a\u0410\u0417\u0410\u041b":1,"\u0410 \u0422\u0410\u041a \u0422\u0410\u041c \u041e\u0414\u0418\u041d \u0418\u041d\u0414\u0423\u0421, \u0414\u0420\u0423\u0413\u041e\u0419 \u0413\u041e\u041b\u041b\u0410\u041d\u0414\u0415\u0426 \u0414\u0410\u0427\u041d\u0418\u041a":1,"\u0422\u0420\u0415\u0422\u0418\u0419 \u0426\u0426\u0412\u0428\u041a\u0410":1,"CCW808":1,"\u0410 \u042d\u0421\u041f\u0415\u0420\u0410\u041d\u0422\u041e \u0417\u041d\u0410\u0415\u0428\u042c?":1,"\u0425\u0417, \u0427\u0401\u0422 \u041d\u0415 \u041f\u041e\u041c\u041d\u042e":1,"\u042d\u0422\u041e \u042f\u0417\u042b\u041a \u041c\u0415\u0416\u0414\u0423\u041d\u0410\u0420\u041e\u0414\u041d\u042b\u0419":1,"\u041d\u0415 \u0424\u0418\u0413\u0423\u0420\u0418\u0420\u041e\u0412\u0410\u041b \u0412 \u041a\u0420\u0418\u041c\u0418\u041d\u0410\u041b\u0415":1,"\u0410, \u042d\u0422\u041e \u0417\u041d\u0410\u042e":1,"\u041d\u0410 \u041d\u0415\u041c \u0410\u041b\u042c \u041a\u0410\u0418\u0414\u0410 \u041e\u0411\u0429\u0410\u0415\u0422\u0421\u042f":1,"\u042f \u0414\u0423\u041c\u0410\u041b \u041d\u0418\u041a":1,"\u041d\u0415 \u041d\u0423 \u042f\u0417\u042b\u041a \u0422\u041e \u041f\u041e\u041d\u042f\u0422\u041d\u041e, \u042f \u0418 \u041c\u0415\u0416\u0421\u041b\u0410\u0412\u042f\u041d\u0421\u041a\u0418\u0419 \u0417\u041d\u0410\u042e \u0427\u0422\u041e \u0421\u0423\u0429\u0415\u0421\u0422\u0412\u0423\u0415\u0422":1,"\u0425\u041e\u0427\u0423 \u0422\u0410\u041a\u041e\u0419 \u0416\u0415 \u041f\u041e \u0410\u041d\u0410\u041b\u041e\u0413\u0418\u0418 \u041c\u0415\u0416\u0422\u042e\u0420\u041a\u0421\u041a\u0418\u0419":1,"\u0418 \u0412\u041e\u0421\u0421\u0422\u0410\u041d\u041e\u0412\u041b\u0415\u041d\u041d\u042b\u0419 \u0427\u0423\u0412\u0410\u0428\u0421\u041a\u0418\u0419":1,"\u0421\u0415\u0419\u0427\u0410\u0421 \u041c\u0415\u041d\u042f \u0412 \u0427\u0423\u0412\u0410\u0428\u0421\u041a\u041e\u041c \u0420\u0423\u0421\u0421\u041a\u0418\u0419 \u0410\u041a\u0426\u0415\u041d\u0422 \u0421\u041c\u0423\u0429\u0410\u0415\u0422, \u041f\u0420\u042f\u041c \u041a\u0410\u041f\u0415\u0426 \u041a\u0410\u041a":1,"\u0417\u0412\u0423\u0427\u0418\u0422 \u041a\u0410\u041a \u0422\u041e \u0417\u0410\u0416\u0410\u0422\u041e \u0421\u041b\u0418\u0428\u041a\u041e\u041c":1,"\u042f \u041d\u0415 \u0428\u0410\u0420\u042e, \u0423 \u041d\u0410\u0421 \u0422\u0423\u0422 \u041a\u0420\u041e\u041c\u0415 \u0422\u0410\u0422\u0410\u0420 \u041d\u0418\u041a\u041e\u0413\u041e \u041d\u0415\u0422":1,"\u0422\u0410\u0422\u0410\u0420\u042b \u0418 \u0420\u0423\u0421\u0421\u041a\u0418\u0415":1,"\u0412\u041e\u0422 \u041f\u0420\u0415\u0414\u0421\u0422\u0410\u0412\u042c \u0422\u0410\u0422\u0410\u0420":1,"\u041e\u041d \u0416\u0415 \u0413\u041e\u0412\u041e\u0420\u0418\u0422 \u041d\u0410 \u0421\u0412\u041e\u0401\u041c":1,"\u0410 \u0412\u0421\u0401 \u0420\u0410\u0412\u041d\u041e \u041d\u0410 \u0420\u0423\u0421\u0421\u041a\u041e\u041c \u0410\u041a\u0426\u0415\u041d\u0422\u0415":1,"\u041f\u0420\u041e\u0418\u0417\u041d\u041e\u0428\u0415\u041d\u0418\u0415 \u041a\u0410\u041a \u0412 \u0420\u0423\u0421\u0421\u041a\u041e\u041c \u042f\u0417\u042b\u041a\u0415":1,"\u0412 \u0417\u0410\u041f\u0410\u0414\u041d\u041e\u0419 \u0421\u0418\u0411\u0418\u0420\u0418 \u041e\u0421\u041e\u0411\u0415\u041d\u041d\u042b\u0419 \u0410\u041a\u0426\u0415\u041d\u0422":1,"\u041e\u0422 \u041c\u041e\u0421\u041a\u041e\u0412\u0421\u041a\u041e\u0413\u041e \u041e\u0422\u041b\u0418\u0427\u0410\u0415\u0422\u0421\u042f":1,"\u0411\u041e\u041b\u0415\u0415 \u0422\u042f\u041d\u0423\u0427\u0418\u0419 \u0422\u0418\u041f?":1,"\u041c\u041e\u0421\u041a\u0412\u0418\u0427\u0418 \u0414\u0415\u041b\u0410\u042e\u0422 \u041d\u0410 \u0410 \u0418 \u0418 \u0410\u041a\u0426\u0415\u041d\u0422\u042b":1,"\u0410 \u0421\u0418\u0411\u0418\u0420\u042c \u0412\u0420\u041e\u0414\u0415 \u041d\u0410 \u0415":1,"\u0423 \u0411\u0410\u0428\u041a\u0418\u0420 \u0412\u0420\u041e\u0414\u0415 \u0421\u041e\u0425\u0420\u0410\u041d\u0418\u041b\u0421\u042f \u0410\u041a\u0426\u0415\u041d\u0422":1,"\u0423 \u041d\u0410\u0421 \u0422\u0410\u041a \u041c\u041e\u0421\u041a\u0412\u0418\u0427\u0415\u0419 \u041e\u0422\u041b\u0418\u0427\u0410\u041b\u0418 \u041e\u0422 \u041c\u0415\u0421\u0422\u041d\u042b\u0425":1,"\u041d\u0415, \u041c\u0415\u041d\u042f \u0412\u041e\u041e\u0411\u0429\u0415 \u0425\u0415\u0420 \u041f\u041e\u0419\u041c\u0401\u0428\u042c \u041f\u041e \u0410\u041a\u0426\u0415\u041d\u0422\u0423":1,"\u0422\u0418\u041f\u0410 \u0414\u0410, \u0410\u0417\u0415\u0420\u0411\u0410\u0419\u0414\u0416\u0410\u041d\u0415\u0426, \u041d\u041e \u0413\u041e\u0412\u041e\u0420\u042e \u041d\u0410 \u0420\u0423\u0421\u0421\u041a\u041e\u041c \u041a\u0410\u041a \u041d\u0410 \u0420\u041e\u0414\u041d\u041e\u041c":1,"\u041c\u041e\u0419 \u0411\u041e\u0415\u0412\u041e\u0419 \u0422\u041e\u0412\u0410\u0420\u0418\u0429 \u0422\u0415\u0410\u0422\u0420\u0410\u041b \u0421\u041a\u0410\u0417\u0410\u041b \u0427\u0422\u041e \u042f \u041f\u0410\u041b\u042e\u0421\u042c \u0422\u041e\u041b\u042c\u041a\u041e \u041f\u041e \u041f\u0420\u041e\u0418\u0417\u041d\u041e\u0428\u0415\u041d\u0418\u042e \u0411\u0423\u041a\u0412\u042b \u042d":1,"\u0418 \u0422\u041e \u041d\u0410\u0414\u041e \u041f\u0420\u042f\u041c \u0411\u042b\u041b\u041e \u0412\u0421\u041b\u0423\u0428\u0418\u0412\u0410\u0422\u042c\u0421\u042f":1,"\u0410, \u041f\u0420\u0418\u041a\u041e\u041b \u041a\u0421\u0422\u0410\u0422\u0418":1,"\u0412 \u0410\u0417\u0415\u0420\u0411\u0410\u0419\u0414\u0416\u0410\u041d\u0415 \u042f \u041f\u0410\u041b\u042e\u0421\u042c \u0422\u041e\u041b\u042c\u041a\u041e \u0422\u0415\u041c \u0427\u0422\u041e \u0413\u041e\u0412\u041e\u0420\u042e \u041d\u0410 \u0411\u041e\u041b\u0415\u0415 \u041b\u0418\u0422\u0415\u0420\u0410\u0422\u0423\u0420\u041d\u041e\u041c":1,"\u0412 \u041e\u0422\u041b\u0418\u0427\u0418\u0418 \u041e\u0422 \u041c\u0415\u0421\u0422\u041d\u042b\u0425 \u041f\u0410\u0426\u0410\u041d\u041e\u0412":1,"\u0423 \u041d\u0410\u0421 \u0422\u0423\u0422 \u041c\u0410\u0422 \u041d\u0410 \u041c\u0410\u0422\u0415":1,"\u041d\u0415, \u041d\u0423 \u041c\u0410\u0422 \u041d\u0410 \u041c\u0410\u0422\u0415 \u042f\u0417\u042b\u041a \u042f \u0417\u041d\u0410\u042e":1,"\u0423\u041f\u041e\u0422\u0420\u0415\u0411\u041b\u042f\u042e \u0422\u041e\u041b\u042c\u041a\u041e \u041a\u041e\u0413\u0414\u0410 \u0421\u0412\u041e\u042f \u041a\u041e\u041c\u041f\u0410\u041d\u0418\u042f":1,"\u0410 \u0422\u0410\u041a \u041a\u0410\u041a \u041f\u0420\u0410\u0412\u0418\u041b\u041e \u0413\u041e\u0412\u041e\u0420\u042e \u041d\u0410 \u041b\u0418\u0422\u0415\u0420\u0410\u0422\u0423\u0420\u041d\u041e\u041c \u0420\u0423\u0421\u0421\u041a\u041e\u041c \u0425\u0414":1,"\u041c\u041e\u0413\u0423 \u0422\u0410\u041c \u0421\u041a\u0420\u0410\u0421\u0418\u0422\u042c \u0418\u041d\u041e\u0413\u0414\u0410 \u0421\u041e\u0412\u0420\u0415\u041c\u0415\u041d\u041d\u042b\u041c\u0418 \u0424\u0420\u0410\u0417\u0410\u041c\u0418, \u041f\u041e \u0422\u0418\u041f\u0423 \"\u0426\u0415\" \u0412\u041c\u0415\u0421\u0422\u041e \"\u042d\u0422\u041e\"":1,"\u0421\u0415\u0413\u041e\u0414\u041d\u042f \u042f\u0417\u042b\u041a \u0411\u041e\u0413\u0410\u0422\u042b\u0419 \u0421\u0422\u0410\u041b":2,"\u041c\u041d\u041e\u0413\u041e \u0418\u041d\u041e\u0421\u0422\u0420\u0410\u041d\u041d\u042b\u0425 \u0424\u0420\u0410\u0417":1,"\u0414\u0410\u0416\u0415 \u0418\u0417 \u041a\u0418\u0411\u0415\u0420\u0421\u041f\u041e\u0420\u0422\u0410":1,"\u041a \u0421\u041e\u0416\u0410\u041b\u0415\u041d\u0418\u042e \u0421 \u0410\u0417\u0415\u0420\u0411\u0410\u0419\u0414\u0416\u0410\u041d\u0421\u041a\u0418\u041c \u042d\u0422\u041e \u0420\u0410\u0411\u041e\u0422\u0410\u0415\u0422 \u0421 \u041e\u041f\u041e\u0417\u0414\u0410\u041d\u0418\u0415\u041c":1,"\u041a\u0410\u041a \u0422\u041e \u0420\u0410\u0417 \u041f\u0420\u0418\u0428\u0401\u041b \u0412 \u041c\u0415\u0421\u0422\u041d\u042b\u0419 \u041c\u0410\u0413\u0410\u0417 \u041c\u041e\u0411\u0418\u041b":1,"\u042f \u0418\u041d\u0422\u0415\u0420\u041d\u0415\u0428\u0418\u041e\u041d\u0410\u041b \u0421\u041c\u041e\u0422\u0420\u0415\u041b \u0413\u041e\u0414 \u041d\u0410\u0417\u0410\u0414":1,"\u0422\u0410\u041c \u0410\u041c\u0415\u0420\u0418\u041a\u0410\u041d\u0426\u042b \u0423\u0416\u0415 \u041d\u0410 \u0420\u0423\u0421\u0421\u041a\u041e\u041c \u041c\u0410\u0422\u0415\u0420\u042f\u0422\u042c\u0421\u042f":1,"\u041d\u0423 \u0422\u0410\u041a \u0412\u041e\u0422, \u041e \u0427\u0415\u041c \u042f":1,"\u041f\u0420\u0418\u0428\u0401\u041b \u0412 \u041c\u0415\u0421\u0422\u041d\u042b\u0419 \u041c\u0410\u0413\u0410\u0417 \u041c\u041e\u0411\u0418\u041b":1,"\u0413\u041e\u0412\u041e\u0420\u042e \u0422\u0410\u041a\u041e\u0419, \u0423 \u0412\u0410\u0421 \u0415\u0421\u0422\u042c MEIZU \u0418\u041b\u0418 XIAOMI":1,"\u041d\u0410 \u041c\u0415\u041d\u042f \u0421\u041c\u041e\u0422\u0420\u042f\u0422 \u0421 \u041a\u0420\u0423\u0413\u041b\u042b\u041c\u0418 \u0413\u041b\u0410\u0417\u0410\u041c\u0418":1,"\u0418 \u0422\u041e\u041b\u042c\u041a\u041e \u0421\u041f\u0423\u0421\u0422\u042f 2-3 \u0413\u041e\u0414\u0410 \u042d\u0422\u0418 \u0411\u0420\u0415\u041d\u0414\u042b \u0421\u0422\u0410\u041b\u0418 \u041f\u041e\u041f\u0423\u041b\u042f\u0420\u041d\u042b\u041c\u0418 \u0423\u0416\u0415 \u0412 \u0410\u0417\u0415\u0420\u0411\u0410\u0419\u0414\u0416\u0410\u041d\u0415":1,"\u041a\u0421\u0422\u0410\u0422\u0418, \u0423 \u041d\u0410\u0421 \u0420\u0415\u0411\u042f\u0422 \u0427\u0418\u0422\u041c\u0415\u0419\u041a\u0415\u0420\u041e\u0412 \u0412\u041e\u0417\u041d\u0418\u041a \u0412\u041e\u041f\u0420\u041e\u0421":1,"\u041a\u0410\u041a \u0422\u042b \u041d\u0410 \u041b\u0418\u041d\u0423\u041a\u0421\u0415 \u0417\u0410\u041f\u0423\u0421\u041a\u0410\u041b \u0416\u0422\u0410\u0428\u041a\u0423?":1,"\u0418 \u041d\u0410 \u0421\u041a\u041e\u041b\u042c\u041a\u041e \u0421\u0418\u041b\u042c\u041d\u041e \u041e\u041d\u0410 \u0423 \u0422\u0415\u0411\u042f \u041b\u0410\u0413\u0410\u0415\u0422":1,"PLAY ON LINUX":1,"\u0422\u0410\u041c \u0411\u042b\u041b\u0418 \u041d\u0415\u0411\u041e\u041b\u042c\u0428\u0418\u0415 \u0422\u0420\u0410\u0411\u041b\u042b \u0421 \u0422\u0415\u041a\u0421\u0422\u0423\u0420\u0410\u041c\u0418":1,"\u041d\u041e \u0418\u0413\u0420\u0410\u0411\u0415\u041b\u042c\u041d\u041e \u0412\u041f\u041e\u041b\u041d\u0415":1,"\u0422\u041e \u0415\u0421\u0422\u042c \u041c\u0422\u0410 \u0417\u0410\u041f\u0423\u0421\u041a\u0410\u041b\u0410\u0421\u042c \u0411\u0415\u0417 \u041f\u0420\u041e\u0411\u041b\u0415\u041c?":1,"\u0418... \u0422\u042b \u041e\u0422\u041a\u041b\u042e\u0427\u0410\u041b \u0410\u041d\u0422\u0418\u0427\u0418\u0422 \u041d\u0410 \u0421\u0415\u0420\u0412\u0415\u0420\u0415?":1,"\u042f \u0414\u0410\u0416\u0415 \u041d\u0415\u041a\u041e\u0422\u041e\u0420\u041e\u0415 \u0412\u0420\u0415\u041c\u042f \u0421\u0415\u0420\u0412\u0415\u0420 \u041f\u0418\u0421\u0410\u041b":1,"\u041d\u0410 \u041b\u0418\u041d\u0423\u041a\u0421\u0415":1,"\u0421\u041b\u0423\u0428\u0410\u0419... \u0422\u042b \u0412 C++ \u0428\u0410\u0420\u0418\u0428\u042c?":1,"\u0412 ++ \u041d\u0415\u0422":1,"\u0411\u041b\u042f\u0422 :C":1,"\u041d\u0410 \u0427\u0418\u0421\u0422\u041e\u041c C \u041d\u0415\u041c\u041d\u041e\u0413\u041e \u0422\u0420\u0415\u041d\u0418\u0420\u041e\u0412\u0410\u041b\u0414\u0421\u042f":1,"\u042f \u041f\u0420\u041e\u0421\u0422 \u041d\u0410 \u041e\u0414\u0418\u041d \u041f\u0420\u041e\u0415\u041a\u0422 \u0418\u0429\u0423 \u0427\u0423\u0412\u0410\u041a\u0410, \u041a\u0422\u041e \u041e\u0422\u0412\u0415\u0422\u0421\u0422\u0412\u0415\u041d\u041d\u042b\u0419 \u0418 \u041c\u041e\u0413\u0401\u0422 \u041d\u0410\u041a\u041e\u041d\u0415\u0426 \u0414\u041e\u041f\u0418\u0421\u0410\u0422\u042c \u0415\u0411\u0423\u0427\u0418\u0419 \u041a\u041b\u0418\u0415\u041d\u0422":1,"\u0423 \u041d\u0410\u0421 \u041a\u0410\u0420\u041e\u0427 \u0412\u0417\u041b\u041e\u041c \u0416\u041e\u041f\u042b \u041d\u0410 \u041b\u0418\u041c\u0418\u0422 \u0422\u0410\u0427\u0415\u041a":1,"\u0418 \u0410\u041d\u0422\u0418\u0427\u0418\u0422 \u041a\u0410\u041a\u041e\u0419 \u0422\u041e \u041d\u0410\u0412\u041e\u0420\u041e\u0427\u0415\u041d\u041d\u042b\u0419":1,"\u0422\u041e\u041a \u0427\u0423\u0412\u0410\u041a \u041a\u041e\u0422\u041e\u0420\u042b\u0419 \u0414\u041e \u042d\u0422\u041e\u0413\u041e \u041f\u0418\u0421\u0410\u041b - \u0421\u042c\u0415\u0411\u0410\u041b\u0421\u042f \u0418\u0417-\u0417\u0410 \u0422\u041e\u0413\u041e \u0427\u0422\u041e \u0415\u041c\u0423 \u041d\u0415 \u0412\u042b\u041f\u041b\u0410\u0422\u0418\u041b\u0418 \u0412\u041e\u0412\u0420\u0415\u041c\u042f \u0414\u0415\u041d\u042c\u0413\u0423":1,"\u0412 \u041e\u0411\u0429\u0415\u041c \u0429\u0410\u0421 \u0412\u041e\u041e\u0411\u0429\u0415 \u0425\u0423\u0419 \u0417\u041d\u0410\u0415\u0422 \u041a \u041a\u041e\u041c\u0423 \u041e\u0411\u0420\u0410\u0429\u0410\u0422\u042c\u0421\u042f":1,"FREELANCE\/":1,"\u0412\u0421\u0415\u041c \u041a\u0422\u041e \u0412 \u0413\u0420\u0423\u041f\u041f\u0410\u0425 - \u041e\u0421\u041e\u0411\u041e \u041d\u0415 \u0414\u041e\u0412\u0415\u0420\u042f\u042e":1,"\u0414\u0410\u041a \u0424\u0420\u0418\u041b\u0410\u041d\u0421\u042b \u0422\u041e \u0420\u0410\u0417\u0412\u0415 \u0417\u0410 \u0418\u0413\u0420\u042b \u0428\u0410\u0420\u042f\u0422?":1,"\u0422\u0410\u041c \u0417\u0410 \u0412\u0421\u0401 \u0412\u0420\u041e\u0414\u0415 \u0428\u0410\u0420\u042f\u0422":1,"0_O":1,"\u041b\u0410\u0414\u041d\u041e, \u041f\u041e\u0421\u041c\u041e\u0422\u0420\u042e \u0422\u0410\u041c":1,"\u0423\u0425\u0425\u0425 \u0421\u041f\u0410\u0422\u042c \u0422\u042f\u041d\u0415\u0422":1,"\u041f\u041e\u0419\u0414\u0423 \u0411\u0410\u0418\u041d\u042c\u041a\u0418":1,"\u041f\u041e\u0419\u0414\u0423 \u041f\u041e\u0416\u0420\u0423 \u0422\u041e\u0416\u0415":1,"\u0410\u041b\u041b\u041e":6,"\u0410\u041b\u041b\u041e\u041e\u041e":1,"\u0412\u042b \u041a\u0415\u041c \u042f\u0412\u041b\u042f\u0415\u0422\u0415\u0421\u042c?":1,"\u0415\u0414\u042c \u0412 \u041a\u041b\u0423\u0411 \u041b\u0412 \u0422\u0410\u041c \u0423\u0412\u0418\u0414\u0418\u041c\u0421\u042f":1,"\u0422\u042b \u0413\u0414\u0415?":1,"\u0412\u0421\u0422\u0423\u041f\u0418 \u0412 \u0413\u0420\u041e\u0423\u0412":1,"\u042f \u0412 \u0411\u041e\u041b\u042c\u041d\u0418\u0426\u0415 \u0417\u0410\u0411\u0418\u0420\u0418 \u041c\u0415\u041d\u042f":1,"\u041a\u0410\u041a \u0422\u042b \u041c\u041d\u0415 \u041f\u041e\u0417\u0412\u041e\u041d\u0418\u041b":1,"\u041a\u041e\u041c\u0410\u041d\u0414\u0410 CALL":1,"\u0410\u041b\u041b\u041e?":1,"\u0415\u0421\u041b\u0418 \u0422\u042b \u0416\u0418\u0412\u041e\u0419 \u0422\u041e \u041a\u0423 \u0413\u041e \u0412\u041c\u0415\u0421\u0422\u0415 \u0418\u0413\u0420\u0410\u0422\u042c?":1,"\u041e\u041a?":1,"\u041f\u041e\u041f\u0410 \u041d\u0415\u0420\u0410\u0410 \u0422\u042b \u0416\u0418\u0412\u0410?":1,"\u0410\u041b\u041e\u041e":1,"\u0410\u041b\u041e\u041e\u041e\u041e\u041e\u041e\u041e\u041e\u041e\u041e\u041e\u041e":1,"\u0410\u041b\u041e\u041e\u041e":1,"\u041f\u0420\u0418\u0412\u0415\u0422!":3,"\u0410\u041b\u041b\u041e!":1,"\u041c\u041e\u0416\u0415\u0428\u042c \u041f\u041e\u041c\u041e\u0427\u042c \u041f\u041e\u0416\u0410\u041b\u0423\u0419\u0421\u0422\u0410?":1,"\u041d\u0423\u0416\u0415\u041d \u0414\u041e\u041d\u041e\u0420, \u0414\u041b\u042f \u0412\u041e\u0417\u041c\u041e\u0416\u041d\u041e\u0421\u0422\u0418 \u0418\u0417\u041b\u0415\u0427\u0415\u041d\u0418\u042f \u0411\u041e\u041b\u0415\u0417\u041d\u0415\u0419, \u041a\u041e\u0422\u041e\u0420\u042b\u0415 \u0422\u0423\u0422 \u0412\u041e\u0417\u041d\u0418\u041a\u0410\u042e\u0422":1,"\u041c\u041e\u0416\u0415\u0428\u042c \u041f\u041e\u0416\u0410\u041b\u0423\u0419\u0421\u0422\u0410 \u041f\u041e\u041c\u041e\u0427\u042c?":1,"\u041d\u0423\u0416\u0415\u041d \u0414\u041e\u041d\u041e\u0420, \u0414\u041b\u042f \u0412\u0417\u042f\u0422\u0418\u042f \u041a\u0420\u041e\u0412\u0418":1,"\u041d\u0410\u0425\u0423\u0419 \u0418\u0414\u0418":1,"\u042f \u0421\u0415\u0420\u042c\u0415\u0417\u041d\u041e":1,"\u0411\u041b\u042f \u041e\u041a":1,"\u0422\u0423\u0422 \u0411\u041e\u041b\u0415\u0417\u041d\u0418 \u0412\u041e\u0417\u041d\u0418\u041a\u0410\u042e\u0422":1,"\u0418\u0417\u041b\u0415\u0427\u0418\u0422\u042c \u0418\u0425 \u042f \u041c\u041e\u0413\u0423 \u0422\u041e\u041b\u042c\u041a\u041e \u041f\u0420\u0418 \u041d\u0410\u041b\u0418\u0427\u0418\u0418 \u041a\u0420\u041e\u0412\u0418 \u0414\u041e\u041d\u041e\u0420\u0410":1,"\u0429\u0410 \u042f \u041f\u0415\u0420\u0415\u0417\u0410\u0419\u0414\u0423 \u0417\u0410 \u0414\u041e\u041a\u0422\u041e\u0420\u0410, \u041d\u0410 \u0414\u041b\u0420\u0423\u0413\u041e\u0413\u041e \u041f\u0415\u0420\u0421\u0410":1,"\u042f \u0417\u0410 \u0422\u041e\u0411\u041e\u0419 \u041f\u041e\u0414\u041b\u0415\u0427\u0423 \u0429\u0410":1,"\u041f\u041e\u041b\u0423\u0427\u0410\u0415\u0422\u0421\u042f?":1,"\u041f\u041e\u041a\u0410\u0417\u042b\u0412\u0410\u0419 \u0422\u041e\u0412\u0410\u0420":1,"\u041d\u0415 \u0425\u041e\u0427\u0415\u0428\u042c \u0412 \u041a\u0410\u041a\u0423\u042e\u0422\u041e \u041e\u0411\u0429\u0410\u041b\u041a\u0423, \u0422\u0418\u041f\u041e \u0414\u0418\u0421\u041a\u041e\u0420\u0414, \u0421\u041a\u0410\u0419\u041f, \u0412\u0410\u0419\u0411\u0415\u0420?":1,"\u041d\u0423 \u041c\u041e\u0416\u041d\u041e":1,"\u041a\u0423\u0414\u0410 \u0423\u0414\u041e\u0411\u041d\u0415\u0419?":1,"\u0414\u0418\u0421\u041a\u041e\u0420\u0414":1,"\u041a\u0410\u041a \u0422\u0415\u0411\u042f \u0422\u0410\u041c \u041d\u0410\u0419\u0422\u0418?":1,"\u0429\u042f":1,"\u0427\u0415\u0411\u0423\u0420\u0415\u041a#2662":1,"\u0418\u0429\u0423 \u0422\u0410\u041a\u041e\u0419 \u041d\u0418\u041a":1,"\u0427\u0415\u0422 \u041d\u0415 \u041d\u0410\u0425\u041e\u0414\u0418\u0422":1,"\u041e\u0423":1,"\u041d\u0415 \u041d\u0410\u0425\u041e\u0414\u0418\u0422 \u0422\u0410\u041a\u041e\u0413\u041e":1,"\u041f\u041e\u041f\u0420\u041e\u0411\u0423\u0419 \u0422\u042b DECIVER#0322":1,"\u042f \u0421\u0414\u041e\u0425":1,"\u0423\u041c\u0415\u0420 \u0418\u041b\u0418 \u041b\u0415\u0416\u0418\u0428\u042c \u041a\u041e\u0420\u042f\u0427\u0418\u0428\u042c\u0421\u042f?":1,"\u0423\u041c\u0415\u0420":1,"\u0414\u0418\u0421\u041a\u041e\u0420\u0414 \u041d\u0415 \u041d\u0410\u0428\u0415\u041b?":1,"\u041a\u0421\u0422\u0410 \u0422\u042b \u0412\u0421\u0401?":1,"\u0414\u0410, \u041d\u0410\u0419\u0414\u0418 \u041c\u0415\u041d \u0412 \u0414\u0418\u041c\u0421\u041a\u041e\u0420\u0414\u0415":1,"\u041a\u0418\u0414\u0410\u0419":1,"DECIVER#0322":1,"\u041f\u0420\u0415\u041d\u0418\u041c\u0410\u0419":1,"\u0423 \u041c\u0415\u041d\u042f  \u041f\u0418\u041d\u0413 \u0417\u0410\u0428\u041a\u0410\u041b\u0418\u0412\u0410\u0415\u0422 \u0411\u041b\u0418\u041d, \u0418\u0413\u0420\u0410\u0422\u042c \u041d\u041e\u0420\u041c\u0410\u041b\u042c\u041d\u041e \u041d\u0415 \u0414\u0410\u0415\u0422":1,"\u0417\u0412\u041e\u041d\u042e \u0412\u0420\u041e\u0414\u0415":1,"\u0423 \u041c\u0415\u041d\u042f \u0411\u0415\u0414\u0410 \u0421 \u0418\u041d\u0415\u0422\u041e\u041c. \u041f\u041e\u0419\u0414\u0423 \u0420\u041e\u0423\u0422\u0415\u0420 \u041f\u0415\u0420\u0415\u0417\u0410\u041f\u0423\u0429\u0423, \u0421\u041a\u041e\u0420\u041e \u0411\u0423\u0414\u0423":1,"\u041f\u0420\u0418\u0412\u0415\u0422! \u0420\u0423\u0421\u0421\u041a\u0418\u0419?":1,"RU?":1,"\u0425\u0423\u0419":1,"CALL":1}