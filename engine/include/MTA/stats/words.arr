042f \u0418\u041b\u0418 \u041d\u0415\u0422":1,"\u041a\u0423":11,"\u0414\u0410\u0420\u041e\u0423":3,"\u0412\u041e\u041b\u041e\u0414\u042f \u0422\u0410\u041a \u0418 \u041d\u0415 \u041e\u0422\u0412\u0415\u0422\u0418\u041b":1,"\u0422\u041e\u0420\u0427\u0423 \u0423 \u041d\u0415\u0413\u041e \u0412 \u041f\u041e\u0414\u041f\u0418\u0421\u0427\u0418\u041a\u0410\u0425":1,"\u0429\u0410 \u041d\u0410\u041f\u0418\u0428\u0423 \u0415\u041c\u0423":1,"\u041a\u0410\u041a \u0421\u0410\u041c \u0422\u041e?":1,"\u041d\u041e\u0420\u041c\u0410\u041b\u042c\u041d\u041e, \u0421\u041c\u0423\u0422\u041d\u041e\u0415 \u0412\u0420\u0415\u041c\u042f \u041d\u0410\u0414\u041e\u0415\u041b\u041e":1,"+":2,"\u0423 \u041d\u0410\u0421 \u0412\u041e\u041d \u0422\u041e\u0416\u0415, \u0414\u0418\u0421\u0422\u0410\u041d\u0426\u0418\u041e\u041d\u041a\u0423 \u0412\u0412\u0415\u041b\u0418":1,"\u0422\u0410\u041a\u0410\u042f \u0415\u0420\u0423\u041d\u0414\u0418\u0421\u0422\u0418\u041a\u0410":1,"\u0412\u041e\u041e\u0411\u0429\u0415 \u041c\u041d\u0415 \u041d\u0420\u0410\u0412\u0418\u0422\u0421\u042f":1,"\u0421 \u042d\u041a\u041e\u041d\u041e\u041c\u0418\u0427\u0415\u0421\u041a\u041e\u0419 \u0422\u041e\u0427\u041a\u0418 \u0417\u0420\u0415\u041d\u0418\u042f":1,"\u041f\u0415\u0420\u0421\u041f\u0415\u041a\u0422\u0418\u0412\u041d\u041e":1,"\u041c\u0410\u0428\u0418\u041d \u041c\u0415\u041d\u042c\u0428\u0415, \u0423\u0421\u041b\u041e\u0412\u0418\u042f \u041a\u041e\u041c\u0424\u041e\u0420\u0422\u041d\u0415\u0415":1,"3 \u0420\u0410\u0417 \u041f\u041e\u0414\u0420\u042f\u0414 \u041f\u0415\u0420\u0415\u0412\u041e\u0420\u0410\u0427\u0418\u0412\u0410\u042e\u0421\u042c":1,"\u0412\u041b\u0410\u0414\u0418\u041c\u0418\u0420 21:00   \u041d\u0415":1,"\u0412\u041b\u0410\u0414\u0418\u041c\u0418\u0420 21:01   \u0422\u0410\u041c \u041d\u0415 \u0422\u0410\u041a \u041f\u0420\u041e\u0421\u0422\u041e \u0416\u0415 \u0421 \u041f\u041e\u0412\u0420\u0415\u0416\u0414\u0415\u041d\u0418\u042f\u041c\u0418":1,"\u041a\u0410\u0416\u0418\u0421\u042c \u0415\u041c\u0423 \u0422\u041e\u0416\u0415 \u041d\u0415\u041e\u0425\u041e\u0422\u0410":1,"\u0422\u0410\u041c \u041f\u0418\u0417\u0414\u0415\u0426":1,"\u0422\u042b \u0415\u041c\u0423 \u0425\u041e\u0422\u042f \u0411\u042b \u0421\u041a\u0410\u0417\u0410\u041b \u0427\u0422\u041e \u0421\u0410\u041c\u0418 \u0428\u0415\u0419\u0414\u0415\u0420\u042b \u0415\u0421\u0422\u042c?":1,"\u0411\u041b\u042f\u0422\u042c \u041a\u0410\u041a \u042d\u0422\u041e\u0422 \u041f\u041e\u041b\u042f\u041a \u0421\u0414\u0415\u041b\u0410\u041b \u042d\u0422\u041e":1," \u0410\u041b\u0415\u041a\u0421\u0415\u0419 \u0410\u041b\u0415\u041a\u0421\u0415\u0419 21:01   \u0421\u0410\u041c \u0428\u0415\u0419\u0414\u0415\u0420 \u0423 \u041d\u0415\u0413\u041e \u0415\u0421\u0422\u042c, \u041a\u0410\u041a \u0415\u0413\u041e \u0422\u041e\u041b\u042c\u041a\u041e \u0417\u0410\u041f\u0423\u0421\u0422\u0418\u0422\u042c":1,"\u041f\u0418\u0417\u0414\u0415\u0426":3,"\u041d\u0423\u0416\u041d\u042b \u0424\u0418\u0417\u0418\u041a\u0418 \u0418 \u041c\u0410\u0422\u0415\u041c\u0410\u0422\u0418\u041a\u0418":1,"\u042f \u0425\u0417, \u041c\u0411 \u0412 \u042d\u0422\u041e\u0419 \u041f\u0410\u041f\u041a\u0415 \u0421 \u0428\u0415\u0419\u0414\u0415\u0420\u0410\u041c\u0418 \u0413\u0414\u0415 \u0422\u041e \u0415\u0429\u0401 \u0418 \u0421\u0410\u041c \u0421\u041a\u0420\u0418\u041f\u0422 \u0411\u042b\u041b":1,"\u041e\u0422\u041a\u0423\u0414\u0410 \u042d\u0422\u041e\u0422 \u041f\u041e\u041b\u042f\u041a \u0421\u0427\u0415\u0420\u041f\u0410\u041b \u0421\u0415\u0411\u0415 ":1,"\u041e\u0411\u0418\u0414\u041d\u041e \u0427\u0422\u041e \u041a\u0410\u041f\u0415\u0426":1,"\u041d\u0418\u041a\u041e\u041c\u0423 \u041d\u0418\u0427\u0415\u0413\u041e \u041d\u0415 \u041d\u0410\u0414\u041e":1,"\u042f \u0421\u0410\u041c \u0412 \u0410\u0425\u0423\u0415":1,"\u041d\u0423 \u0418 \u041f\u0423\u0421\u041a\u0410\u0419 \u0416\u0418\u0412\u0423\u0422":1,"\u0412 \u0421\u0412\u041e\u0401\u041c \u041c\u0423\u041b\u042c\u0422\u042f\u0428\u041d\u041e\u041c \u041c\u0418\u0420\u0415":1,"\u0418\u041b\u0418 \u0412 \u041d\u0410\u0428\u0415\u041c":1,"\u0421 \u041d\u0415\u041b\u041e\u041c\u0410\u042e\u0429\u0418\u041c\u0418\u0421\u042f \u0422\u0410\u0427\u041a\u0410\u041c\u0418":1,"\u041f\u041e\u0421\u041c\u041e\u0422\u0420\u0418\u041c":1,"\u0427\u0415 \u041d\u0418\u0411\u0423\u0414\u042c \u041f\u0420\u0418\u0414\u0423\u041c\u0410\u0415\u041c":1,"\u041a\u0410\u041a \u0422\u042b \u0413\u041e\u0412\u041e\u0420\u0418\u041b":1,"\u0412\u0421\u0415\u0413\u0414\u0410 \u041c\u041e\u0416\u041d\u041e \u041f\u041e\u0419\u0422\u0418 \u041f\u041e \u041f\u0423\u0422\u0418 \u0410\u0412\u0421\u0422\u0420\u0418\u0419\u0421\u041a\u041e\u0413\u041e \u0425\u0423\u0414\u041e\u0416\u041d\u0418\u041a\u0410":1,"\u0411\u041b\u042f, \u042f \u041d\u0415 \u0414\u0423\u041c\u0410\u042e \u0427\u0422\u041e \u042d\u0422\u041e\u0422 \u041f\u041e\u041b\u042f\u041a \u0414\u041e\u0425\u0423\u042f \u041c\u0410\u0422\u0415\u041c\u0410\u0422\u0418\u041a":1,"\u041e\u041d \u0425\u041e\u0422\u042c \u0418 \u041f\u0418\u0421\u0410\u041b \u0427\u0422\u041e \u0421\u041b\u041e\u0416\u041d\u041e \u0411\u042b\u041b\u041e":1,"\u0414\u0423\u041c\u0410\u0415\u0428\u042c \u0421\u041b\u0418\u0417\u0410\u041b \u041e\u0422\u041a\u0423\u0414\u0410 \u0422\u041e?":1,"\u0414\u0410 \u0421\u0422\u041e \u041f\u0423\u0414\u041e\u0412":1,"\u042f \u0414\u0423\u041c\u0410\u042e \u041f\u0420\u041e\u0429\u0415 \u041d\u0410\u041f\u0418\u0421\u0410\u0422\u042c \u0421\u0412\u041e\u0419 \u041a\u041e\u0414":1,"\u0428\u0415\u0419\u0414\u0415\u0420\u0410 \u041e\u041d \u0421\u0410\u041c \u0421\u041a\u0410\u0417\u0410\u041b \u0427\u0422\u041e \u0421\u041f\u0418\u0417\u0414\u0418\u041b \u0421 \u041e\u0414\u041d\u041e\u0413\u041e \u041f\u0420\u041e\u0415\u041a\u0422\u0410":1,"\u042f \u0421\u041a\u041e\u041b\u042c\u041a\u041e \u041f\u042b\u0422\u0410\u041b\u0421\u042f, \u0412 \u0427\u0423\u0416\u041e\u041c \u0422\u0423\u0413\u041e \u0421\u041e\u041e\u0411\u0420\u0410\u0416\u0410\u042e":1,"\u0414\u041e\u041b\u0411\u0410\u041d\u041d\u042b\u0419 \u041c\u0415\u041b\u041a\u041e\u0421\u041e\u0424\u0422 \u0425\u041b\u0421\u041b":1,"\u041f\u0420\u0418\u0414\u0423\u041c\u0410\u041b\u0418 \u0412\u0415\u0414\u042c, \u0418 \u0425\u0415\u0420 \u041f\u041e\u0419\u041c\u0401\u0428\u042c \u041a\u0410\u041a \u041e\u041d\u041e \u0420\u0410\u0411\u041e\u0422\u0410\u0415\u0422":1,"\u041d\u0410 \u0428\u0415\u0419\u0414\u0415\u0420\u041d\u042b\u0419 \u042f\u0417\u042b\u041a \u0415\u0429\u0415 \u0414\u041e\u041a\u0423\u041c\u0415\u041d\u0422\u0410\u0426\u0418\u042f \u0421\u041b\u0410\u0411\u0410\u042f":1,"++":3,"\u0417\u041d\u0410\u0415\u0428\u042c \u041a\u0410\u041a \u0413\u041e\u0412\u041e\u0420\u0418\u0422 \u041e\u0414\u0418\u041d \u0425\u0420\u0418\u0421\u0422\u0418\u0410\u041d\u0418\u041d":1,"?":6,"\u041a\u0420\u0423\u0413\u041e\u041c \u041e\u0414\u041d\u0418 \u0411\u041e\u0422\u042b":1,"\u041b\u0415\u041b\u042c":1,"\u0412 \u0427\u0415\u041c \u0422\u041e \u041e\u041d \u041f\u0420\u0410\u0412":1,"\u041d\u0423 \u0414\u0410, \u041c\u042b\u0421\u041b\u042f\u0422 \u041e\u0414\u0418\u041d\u0410\u041a\u041e\u0412\u041e \u0422\u0423\u0413\u041e":1,"\u041d\u0418\u0427\u0415\u0413\u041e \u041d\u041e\u0412\u041e\u0413\u041e \u041f\u0420\u0418\u0414\u0423\u041c\u042b\u0412\u0410\u0422\u042c \u041d\u0415 \u0425\u041e\u0422\u042f\u0422":1,"\u041f\u0420\u0418\u0427\u0401\u041c \u0411\u041b\u042f, \u041f\u0420\u0418\u041a\u041e\u041b":1,"\u041f\u0421\u0418\u0425\u041e\u041b\u041e\u0413\u0418\u0427\u0415\u0421\u041a\u0418 \u0422\u0420\u0423\u0414\u041d\u041e \u041f\u0420\u0418\u041d\u0418\u041c\u0410\u0422\u042c \u0427\u0422\u041e-\u0422\u041e \u041d\u041e\u0412\u041e\u0415 \u041d\u0410\u0412\u0415\u0420\u041d\u041e\u0415":1,"\u042f \u0425\u0417":1,"\u042d\u0422\u041e\u0419 \u0422\u0415\u041c\u0415 \u0421 \u041f\u041e\u0412\u0420\u0415\u0416\u0414\u0415\u041d\u0418\u042f\u041c\u0418 \u041b\u0415\u0422 5 \u0423\u0416\u0415 \u0422\u041e\u0427\u041d\u041e \u0415\u0421\u0422\u042c":1,"\u042f \u0412\u0418\u0414\u0415\u041b \u0415\u0429\u0401 \u041d\u0410 \u041e\u0414\u041d\u041e\u041c \u0414\u0415\u0420\u0411\u0418 \u0421\u0415\u0420\u0412\u0410\u041a\u0415, \u0422\u0410\u041c \u0422\u0410\u0427\u041a\u0418 \u0413\u041d\u0423\u041b\u0418\u0421\u042c":1,"\u041d\u0423\u0416\u041d\u041e \u041a\u041e\u041c\u041c\u042c\u042e\u041d\u0418\u0422\u0418 \u0421\u041e\u0411\u0418\u0420\u0410\u0422\u042c":1,"\u041d\u041e \u0411\u041e\u041b\u042c\u0428\u0415 \u041a\u0410\u041a \u041d\u0410\u0421\u0422\u041e\u042f\u0429\u0418\u0415, \u0427\u0415\u041c \u041f\u041b\u0410\u0421\u0422\u0418\u041b\u0418\u041d\u041e\u0412\u042b\u0415":1,"\u0414\u041b\u042f \u041a\u041e\u041b\u041b\u0415\u041a\u0422\u0418\u0412\u041d\u041e\u0419 \u0420\u0410\u0417\u0420\u0410\u0411\u041e\u0422\u041a\u0418":1,"\u041d\u0418\u041a\u041e\u041c\u0423 \u041d\u0418\u0427\u0415\u0413\u041e \u041d\u0415 \u041d\u0423\u0416\u041d\u041e":1,"\u041d\u0418\u041a\u0422\u041e \u041d\u0418\u0427\u0415\u0413\u041e \u041d\u0415 \u0425\u041e\u0427\u0415\u0422":1,"\u0429\u0410\u0421 \u0412\u0420\u041e\u0414\u0415 MRQ1V1 \u0427\u0422\u041e-\u0422\u041e \u041f\u042b\u0422\u0410\u0415\u0422\u0421\u042f \u041a\u041e\u0412\u042b\u0420\u042f\u0422\u042c":1,"\u0418 \u0422\u041e \u0425\u041e\u0420\u041e\u0428\u041e":1,"\u041a\u0421\u0422\u0410\u0422\u0418":4,"\u041a\u0423\u0414\u0410 \u0422\u042b \u0418\u041d\u0422\u042b \u0414\u0415\u041b":1,"\u0422\u041e\u0427\u041d\u0415\u0415 \u041e\u0422\u041a\u0420\u042b\u0422\u042b\u0415 \u0425\u0410\u0422\u042b":1,"\u041f\u041e\u041a\u0410 \u0427\u0422\u041e \u041e\u0422\u041a\u041b\u042e\u0427\u0418\u041b, \u041d\u0410\u0414\u041e \u0411\u0423\u0414\u0415\u0422 \u0412\u0420\u0415\u041c\u0415\u041d\u0418 \u0411\u041e\u041b\u042c\u0428\u0415 \u0423\u0414\u0415\u041b\u0418\u0422\u042c":1,"\u041d\u0410 \u041e\u0422\u041a\u0420\u042b\u0422\u0418\u0415 \u0414\u041e\u041c\u041e\u0412":1,"\u042f \u0411\u041b\u042f \u0422\u041e\u0427\u041a\u0423 \u0412\u041e\u0417\u0418\u041b ":1,"\u0425\u041e\u0422\u0415\u041b \u041f\u041e\u041a\u0410\u0417\u0410\u0422\u042c \u0414\u041e\u041c\u0418\u041a \u0412 \u041f\u0423\u0421\u0422\u042b\u041d\u0415":1,"\u0418 \u0425\u0423\u0419, \u041e\u0411\u041b\u041e\u041c\u0410\u041b\u0421\u042f":1,"\u0410\u0425\u0410\u0425\u0410\u0425\u0410\u0425":1,"\u0412\u041e \u0422\u0423\u041f\u041e \u041d\u0410\u0412\u0415\u0420\u041d\u041e\u0415 \u0412\u042b\u0413\u041b\u042f\u0414\u0415\u041b\u041e))":1,"\u0414\u0410 \u041a\u0410\u041f\u0415\u0426":1,"\u041e\u041d \u0421\u042b\u0420\u041e\u0412\u0410\u0422 \u0415\u0429\u0415":1,"\u042f \u0425\u041e\u0427\u0423 \u0421\u0414\u0415\u041b\u0410\u0422\u042c \u0422\u0410\u041a":1,"\u0421\u041d\u0410\u0427\u0410\u041b\u0410 \u041e\u0422\u041a\u0420\u042b\u0422\u042c \u0412\u0421\u0415 \u0414\u0412\u0415\u0420\u0418, \u0410 \u041f\u041e\u0422\u041e\u041c \u0423\u0411\u0420\u0410\u0422\u042c \u0412\u0421\u0415 \u0414\u041e\u041c\u0410":1,"\u041a\u041e\u0422\u041e\u0420\u042b\u0415 \u0418\u041a\u041e\u041d\u041a\u0418":1,"\u0410 \u041f\u0415\u0420\u0415\u0425\u041e\u0414\u041d\u041e\u0419 \u0420\u0415\u0416\u0418\u041c \u041b\u0423\u0427\u0428\u0415 \u0423\u0411\u0420\u0410\u0422\u042c":1,"\u041d\u0410\u0414\u041e \u0415\u0429\u0401 \u0414\u041b\u042f \u042d\u0422\u0418\u0425 \u0414\u041e\u041c\u041e\u0412 \u041e\u0411\u042c\u0415\u041a\u0422\u042b \u0414\u0412\u0415\u0420\u0415\u0419 \u0421\u0414\u0415\u041b\u0410\u0422\u042c":1,"\u0418\u041b\u0418 \u041c\u041e\u0416\u041d\u041e \u041e\u0421\u0422\u0410\u0412\u0418\u0422\u042c":1,"\u0422.\u041a. \u0421\u0422\u0410\u041d\u0414\u0410\u0420\u0422\u041d\u042b\u0415 \u0421\u041b\u0418\u0428\u041a\u041e\u041c \u041e\u0413\u0420\u041e\u041c\u041d\u042b\u0415":1,"\u042d\u0422\u041e 3D \u041c\u041e\u0414\u0415\u041b\u0418\u0420\u041e\u0412\u0410\u041d\u0418\u0415":1,"\u041f\u041b\u042e\u0421 \u0417\u0410\u041c\u0415\u041d\u0410 \u0421\u0422\u0410\u041d\u0414\u0410\u0420\u0422\u041d\u042b\u0425 \u041e\u0411\u042a\u0415\u041a\u0422\u041e\u0412":1,"\u0422\u0410 \u041d\u0423, \u041a\u0410\u041a\u041e\u0419 \u041d\u0410\u0425\u0420\u0415\u041d, \u0412\u0417\u042f\u041b \u0412\u042b\u0420\u0415\u0417\u0410\u041b \u0421 \u0425\u0410\u0422\u042b \u0414\u0412\u0415\u0420\u042c":1,"\u041a\u0421\u0422\u0410\u0422\u0418, \u041e\u041d\u0418 \u0414\u041e \u0421\u0418\u0425 \u041f\u041e\u0420 \u041d\u0415 \u0421\u0414\u0415\u041b\u0410\u041b\u0418 \u0414\u041e\u0411\u0410\u0412\u041b\u0415\u041d\u0418\u0415 \u041d\u041e\u0412\u042b\u0425 ID \u041e\u0411\u042a\u0415\u041a\u0422\u041e\u0412":1,"\u041d\u0423\u0416\u041d\u041e \u041a\u0410\u041a\u041e\u0419 \u0422\u041e \u0418\u0417 \u0418\u0413\u0420\u042b \u0423\u0414\u0410\u041b\u042f\u0422\u042c, \u0418 \u0412\u041c\u0415\u0421\u0422\u041e \u041d\u0415\u0413\u041e \u0421\u0422\u0410\u0412\u0418\u0422\u042c":1,"\u042d\u0422\u041e \u0414\u0410, \u041d\u041e \u041a\u0423\u0427\u0410 \u041d\u0415 \u0417\u0410\u042e\u0417\u0410\u041d\u041d\u042b\u0425 \u041e\u0411\u042c\u0415\u041a\u0422\u041e\u0412 \u0412 \u0418\u0413\u0420\u0415":1,"\u0422\u041e\u0422 \u0416\u0415 \u041b\u0418\u0411\u0415\u0420\u0422\u0418 \u0421\u0418\u0422\u0418":1,"\u041d\u0423 \u0422\u0418\u041f \u0412 \u041c\u0418\u0421\u0421\u0418\u0418 \u041e\u041d \u0411\u042b\u041b":1,"\\":1,"\u0410 \u041d\u0423 \u0414\u0410":1,"\u041d\u0410 \u0420\u0423\u041b\u042c":1,"\u0410 \u0429\u0410\u0421 \u0425\u0415\u0420 \u041a\u0422\u041e \u0422\u0423\u0414\u0410 \u0417\u0410\u041b\u0415\u0417\u0415\u0422":1,"\u042f \u041f\u041e\u0419\u0414\u0423 \u041f\u041e \u0421\u041f\u041b\u042e, \u0410 \u0422\u041e \u0421 \u0420\u0410\u0411\u041e\u0422\u042b \u0421\u0415\u0413\u041e\u0414\u041d\u042f":1,"\u041e\u041a\u0415\u0419":4,"\u041f\u0420\u0418\u042f\u0422\u041d\u042b\u0425 \u0421\u041d\u041e\u0412":1,"\u041e\u041e \u041f\u0420\u0418\u0412\u0415\u0422":1,"\u041f\u0420\u0418\u0412\u0415\u0422)":2,"\u0414\u0410\u0412\u041d\u041e \u041d\u0415 \u0412\u0418\u0414\u0415\u041b\u0418\u0421\u042c)":1,"\u0421\u041e\u0413\u041b\u0410\u0421\u0415\u041d":1,"\u0420\u0410\u0411\u041e\u0422\u0410":1,"\u041d\u0423 \u0428\u041e \u041a\u0410\u041a \u0422\u042b":1,"\u041b\u0423\u0427\u0428\u0415 \u0412\u0421\u0415\u0425, \u041d\u0418\u041a\u0422\u041e \u041d\u0415 \u0417\u0410\u0412\u0418\u0414\u0423\u0415\u0422":1,"\u0425\u0410\u0425\u0410)":1,"\u0418\u0414\u0418 \u0421\u042e\u0414\u0410":2,"\u0423\u041e \u041c\u041d\u0415":1,"\u041f\u041e\u0417\u0416\u0415 \u0417\u0410\u0419\u0414\u0423 \u0412\u041e\u0417\u041c\u041e\u0416\u041d\u041e), \u0417\u0410\u0428\u0415\u041b \u0417\u0410 \u0421\u0412\u0415\u0422 \u0420\u0410\u0421\u041a\u0418\u0414\u0410\u0422\u042c\u0421\u042f":1,"\u041b\u0415\u0422\u0418*":1,"\u041b\u041e\u041b \u0425\u0410\u0425\u0410)":1,"\u0414\u041e \u0412\u0421\u0422\u0420\u0415\u0427\u0418":1,"\u041d\u0423 \u041f\u0410\u0420\u0423 \u0421\u0415\u041a \u0418\u0414\u0418 \u041a\u041e \u041c\u041d\u0415":1,"\u0410\u041b\u041e":2,"\u041d\u041e\u0412\u042b\u0419 \u0422\u0423\u0422?":1,"\u0422\u0410 \u0414\u0410":1,"\u041a\u0410\u041a \u0422\u0415\u0411\u0415 \u041e\u0417\u0412\u0423\u0427\u041a\u0410?":1,"\u0425\u0423\u0418\u0422\u0410":1,"\u0410 \u0416\u0410\u041b\u042c":1,"\u0427\u0423\u0412\u0410\u041a \u041d\u0410\u0414 \u042d\u0422\u041e\u0419 \u041e\u0417\u0412\u0423\u0427\u041a\u041e\u0419 \u041f\u041e\u0422\u0415\u041b":1,"\u041f\u041e\u0427\u0415\u041c\u0423?":1,"\u041d\u0423 \u041a\u0410\u041a \u0416\u0415, \u0412 \u041c\u0422\u0410":1,"\u0415\u0429\u0401 \u0418 \u0412\u0421\u0422\u0420\u041e\u0418\u0422\u042c \u0413\u041e\u0412\u041e\u0420\u0418\u041b\u041a\u0423":2,"\u0422\u042b \u0420\u0415\u0410\u041b\u042c\u041d\u0418\u0419?":1,"\u041f\u0420\u0418\u041a\u0418\u041d\u042c":1,"\u041d\u0415\u0422 \u0411\u041b\u042f\u0422\u042c \u041f\u0423\u0428\u041a\u0418\u041d :D":1,"\u042f \u0412 \u0410\u0425\u0423\u0415 \u0422\u041e\u0413\u0414\u0410":1,"\u0428\u041e, \u0414\u0415 \u0422\u042f \u0417\u0410\u0411\u0420\u0410\u0422\u042c":1,"\u042f \u0412 \u0411\u0410\u0420\u0415":1,"\u041b\u0412?":1,"\u0429\u0410":5,"\u0416\u04